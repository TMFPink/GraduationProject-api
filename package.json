{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:dev": "NODE_ENV=development & nodemon server.js",
    "start:prod": "NODE_ENV=production & node ./server.js",
    "seed:generate-new": "npx sequelize-cli seed:generate --name",
    "seed:down-and-up": "npx sequelize-cli db:seed:undo:all && npx sequelize-cli db:seed:all",
    "migrate:generate-new": "npx sequelize-cli migration:generate -n",
    "migrate:auto-generate": "npx sequelize-mig migration:make -n",
    "migrate:up": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@tcgdex/sdk": "^2.7.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongoose": "^8.2.3",
    "morgan": "~1.9.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.3",
    "pg": "^8.16.3",
    "refs": "^0.9.7",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prettier": "3.6.2",
    "sequelize-cli": "^6.6.2",
    "sequelize-mig": "^3.1.3"
  },
  "nodemonConfig": {
    "ext": "js,json,yaml,yml"
  },
  "packageManager": "yarn@4.1.0+sha512.5b7bc055cad63273dda27df1570a5d2eb4a9f03b35b394d3d55393c2a5560a17f5cef30944b11d6a48bcbcfc1c3a26d618aae77044774c529ba36cb771ad5b0f"
}
